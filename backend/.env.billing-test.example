# Copiar como .env.billing-test.local (ignorado por Git) y completar SOLO con datos de prueba.
# No usar este archivo en los servicios productivos de Render.
BILLING_TEST_ENVIRONMENT=isolated
BILLING_ENABLED=false
BILLING_RECONCILIATION_ENABLED=false
BOOTSTRAP_DEMO=false

# Instancia MySQL separada en Railway, base disenolys_billing_test y usuario exclusivo.
DATABASE_URL=
# Origen HTTPS del frontend de prueba, sin ruta.
FRONTEND_URL=
# URL HTTPS del backend de prueba, terminada en /billing/webhook.
BILLING_WEBHOOK_URL=

# IDs y email obtenidos de Cuentas de prueba de Mercado Pago, país Argentina.
BILLING_TEST_SELLER_ID=
BILLING_TEST_BUYER_ID=
BILLING_TEST_BUYER_EMAIL=
# Credenciales de la aplicación creada dentro de la CUENTA VENDEDORA DE PRUEBA.
MP_SUBSCRIPTIONS_ACCESS_TOKEN=
MP_SUBSCRIPTIONS_WEBHOOK_SECRET=

# Secreto nuevo, exclusivo del backend de prueba. No copiar JWT_SECRET de producción.
JWT_SECRET=
