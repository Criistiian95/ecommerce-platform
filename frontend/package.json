{
  "name": "ecommerce-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test test/*.test.cjs",
    "dev:static": "vite --config vite.config.mts",
    "build:static": "tsc --project static/tsconfig.json && vite build --config vite.config.mts",
    "preview:static": "vite preview --config vite.config.mts",
    "test:static": "playwright test --config playwright.static.config.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
